+// Add the core files from tekibo/cdn release
+async function ensureCustomCoreBinaries() {
+  const coreDir = join(electrobunDir, 'dist-win-x64');
+  const checkFile = join(coreDir, 'libNativeWrapper.dll');
+
+  // If the core files are already there, skip!
+  if (existsSync(checkFile)) {
+    return;
+  }
+
+  console.log('Pre-fetching custom KiboStudio core binaries...');
+  const tarballUrl = "https://github.com/tekibo/cdn/releases/download/electrobun_custom_v1/electrobun-core-files-v1.tar.gz";
+  const tarballPath = join(cacheDir, `kibo-core-payload.tar.gz`);
+
+  try {
+    await downloadFile(tarballUrl, tarballPath);
+
+    // Extract directly into the electrobun root (since our tarball contains the dist/ and dist-win-x64/ folders)
+    execSync(`${getTarCommand()} -xzf "${tarballPath}" -C "${electrobunDir}"`, { stdio: 'pipe' });
+
+    unlinkSync(tarballPath);
+    console.log('Custom core binaries injected successfully!');
+  } catch (error) {
+    throw new Error(`Failed to inject custom core binaries: ${error.message}`);
+  }
+}
