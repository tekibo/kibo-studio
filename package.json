{
	"name": "kibo-studio",
	"version": "1.0.0",
	"description": "Local AI image studio powered by CPP",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:dev": "bun install && vite build && electrobun build",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:stable": "vite build && electrobun build --env=stable"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@tailwindcss/vite": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "^1.18.4-beta.3",
		"lucide-react": "^1.16.0",
		"next-themes": "^0.4.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"shadcn": "^4.7.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"rcedit": "^5.0.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	},
	"patchedDependencies": {
		"electrobun@1.18.4-beta.3": "patches/electrobun@1.18.4-beta.3.patch"
	}
}